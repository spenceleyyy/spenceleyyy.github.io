# --- Summarizer ---
summarize_psd_dyad_median <- function(df, value_col, chans, region_label, exclude_dyads = c("E14")) {
df %>%
filter(
band == "theta",
channel_name %in% chans,
code %in% c("HHH","HRR"),
teammate %in% c("A","B"),
!(dyad_id %in% exclude_dyads)
) %>%
mutate(
code = as.character(code) %>% tolower(),
role = case_when(
teammate == "A" ~ "MC",
teammate == "B" ~ "SO",
TRUE ~ NA_character_
),
code = case_when(
code == "hhh" ~ "mH",
code == "hrr" ~ "mHR",
TRUE ~ code
)
) %>%
filter(!is.na(role)) %>%
group_by(dyad_id, channel_name, role, code) %>%
