cat("- Beta: Fp1, T8\n")
cat("- Delta: FC2\n")
cat("- Broadband: FT9 (trend after FDR), O1\n")
cat("\nFiles saved:\n")
cat("1. wpli_significant_findings.csv (long format)\n")
cat("2. wpli_significant_findings_wide.csv (wide format)\n")
