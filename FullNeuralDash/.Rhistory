# --- Collect summaries ---
fp_abs <- summarize_psd_dyad_median(PSD_clean, "abs_power", c("Fp1","Fp2"), "Frontal")
fp_rel <- summarize_psd_dyad_median(PSD_clean, "rel_power", c("Fp1","Fp2"), "Frontal")
tp_abs <- summarize_psd_dyad_median(PSD_clean, "abs_power", c("TP9","TP10"), "TPJ")
tp_rel <- summarize_psd_dyad_median(PSD_clean, "rel_power", c("TP9","TP10"), "TPJ")
# --- Y-limits ---
all_abs <- bind_rows(fp_abs, tp_abs)
all_rel <- bind_rows(fp_rel, tp_rel)
ABS_MAX <- 15
REL_MAX <- ceiling(max(all_rel$val, na.rm = TRUE) * 100) / 100
abs_limits <- c(0, ABS_MAX)
rel_limits <- c(0, REL_MAX)
# --- Color palette for role + condition ---
role_condition_colors <- c(
"MC.mH" = "#9ecae1",    # light blue
"MC.mHR" = "#08519c",   # dark blue
"SO.mH" = "#fc9272",    # light red
"SO.mHR" = "#cb181d"    # dark red
)
# --- Plot Function ---
make_psd_plot <- function(df, ylab, title,
fixed_ylim = NULL,
channel_levels,
channel_labels = channel_levels,
show_legend = FALSE) {
df_processed <- df %>%
mutate(
channel_name = factor(channel_name, levels = channel_levels),
role = factor(role, levels = c("MC", "SO")),
code = factor(code, levels = c("mH", "mHR")),
role_code = paste(role, code, sep = ".")
)
# Calculate summary stats
df_summary <- df_processed %>%
group_by(channel_name, role, code, role_code) %>%
summarise(
n = n(),
median_val = median(val, na.rm = TRUE),
q1 = quantile(val, 0.25, na.rm = TRUE),
q3 = quantile(val, 0.75, na.rm = TRUE),
.groups = "drop"
)
p <- ggplot(df_summary, aes(x = channel_name, y = median_val,
fill = role_code)) +
# Median bars
geom_col(position = position_dodge(width = 0.8),
width = 0.7, color = "grey30", linewidth = 0.4) +
# Error bars (Q1 to Q3)
geom_errorbar(aes(ymin = q1, ymax = q3),
position = position_dodge(width = 0.8),
width = 0.25, linewidth = 0.8, color = "grey30") +
scale_fill_manual(
values = role_condition_colors,
labels = c(
"MC.mH" = "MC - mH",
"MC.mHR" = "MC - mHR",
"SO.mH" = "SO - mH",
"SO.mHR" = "SO - mHR"
),
name = NULL
) +
scale_x_discrete(limits = channel_levels, labels = channel_labels) +
labs(x = NULL, y = ylab, title = title) +
theme_minimal(base_size = 13) +
theme(
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_line(color = "grey85", linewidth = 0.3),
panel.border = element_rect(color = "grey50", fill = NA, linewidth = 0.6),
panel.background = element_rect(fill = "white", color = NA),
plot.background = element_rect(fill = "white", color = NA),
axis.text.x = element_text(size = 12, face = "bold", color = "grey30"),
axis.text.y = element_text(size = 11, color = "grey30"),
axis.title.y = element_text(size = 12, face = "bold", color = "grey30",
margin = margin(r = 8)),
axis.ticks = element_line(color = "grey50", linewidth = 0.4),
plot.title = element_text(size = 13, face = "bold", hjust = 0.5, color = "grey30",
margin = margin(b = 10)),
legend.position = if(show_legend) "bottom" else "none",
legend.title = element_text(size = 11, face = "bold", color = "grey30"),
legend.text = element_text(size = 10, color = "grey30"),
legend.background = element_rect(fill = "white", color = NA),
legend.key.size = unit(0.6, "cm"),
plot.margin = margin(t = 10, r = 10, b = 10, l = 10)
)
if (!is.null(fixed_ylim)) {
p <- p + coord_cartesian(ylim = fixed_ylim)
}
p
}
