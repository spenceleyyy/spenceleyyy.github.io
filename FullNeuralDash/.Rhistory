# ==========================================
# WPLI analysis (bandwise, memory-safe)
# ==========================================
suppressPackageStartupMessages({
library(data.table)
library(dplyr)
library(tidyr)
library(readr)
})
# --------- CONFIG ---------
base_dir  <- "/Users/hotcocks/Library/CloudStorage/GoogleDrive-rjspenceley@gmail.com/My Drive/T2DEEGAnalysis/outputs_metrics"
in_csv    <- file.path(base_dir, "ALL_window_wpli_band.csv")
out_dir   <- file.path(base_dir, "outputs_stats")
dir.create(out_dir, showWarnings = FALSE, recursive = TRUE)
bands_run <- c("alpha","beta","delta","theta")   # choose any subset
B_perm    <- 2000                                 # lower while debugging
use_stat  <- "mean"                               # "mean" or "median"
set.seed(123)
# --------- helpers ----------
canon_ch <- function(x){
x <- toupper(trimws(as.character(x)))
gsub("[-_:()/\\\\\\s]", "", x)
}
paired_perm_stream <- function(x, y, stat=c("mean","median"), B=2000){
stat <- match.arg(stat)
d  <- x - y
n  <- length(d)
if (n < 2L) {
return(list(
n_pairs = n, obs = NA_real_,
p_lab = NA_real_, mu_lab = NA_real_, sd_lab = NA_real_,
p_rep = NA_real_, mu_rep = NA_real_, sd_rep = NA_real_
))
}
obs <- if (stat=="mean") mean(d) else median(d)
# Welford accumulators
kL <- 0L; mL <- 0.0; M2L <- 0.0; hitsL <- 0L
kR <- 0L; mR <- 0.0; M2R <- 0.0; hitsR <- 0L
upd <- function(k, m, M2, z){
k  <- k + 1L
d1 <- z - m
m  <- m + d1/k
M2 <- M2 + d1*(z - m)
list(k=k, m=m, M2=M2)
}
for (b in seq_len(B)){
# label-swap (paired flips)
zL <- if (stat=="mean") {
s <- sample(c(-1,1), n, TRUE); mean(d * s)
} else {
s <- sample(c(-1,1), n, TRUE); median(d * s)
}
if (abs(zL) >= abs(obs)) hitsL <- hitsL + 1L
tmp <- upd(kL, mL, M2L, zL); kL <- tmp$k; mL <- tmp$m; M2L <- tmp$M2
# random re-pair (break pairing)
idx <- sample.int(n, n, FALSE)
zR <- if (stat=="mean") mean(x - y[idx]) else median(x - y[idx])
if (abs(zR) >= abs(obs)) hitsR <- hitsR + 1L
tmp <- upd(kR, mR, M2R, zR); kR <- tmp$k; mR <- tmp$m; M2R <- tmp$M2
}
list(
n_pairs = n,
obs = obs,
p_lab = hitsL / B,
mu_lab = mL,
sd_lab = if (kL < 2) NA_real_ else sqrt(M2L/(kL-1)),
p_rep = hitsR / B,
mu_rep = mR,
sd_rep = if (kR < 2) NA_real_ else sqrt(M2R/(kR-1))
)
}
test_one_group <- function(df){
# df columns: dyad_id, code, val  (paired by dyad_id)
wide <- df |>
mutate(code = factor(code, levels=c("HHH","HRR"))) |>
group_by(dyad_id, code) |>
summarise(val = mean(val, na.rm=TRUE), .groups="drop") |>
tidyr::pivot_wider(names_from = code, values_from = val) |>
drop_na(HHH, HRR) |>
as_tibble()
if (nrow(wide) < 2L) {
return(tibble(
n_pairs = nrow(wide),
obs_diff = NA_real_,
p_perm_2s_label = NA_real_, null_mean_label = NA_real_, null_sd_label = NA_real_,
p_perm_2s_repair= NA_real_, null_mean_repair= NA_real_, null_sd_repair= NA_real_,
p_wilcoxon = NA_real_
))
}
s <- paired_perm_stream(wide$HHH, wide$HRR, stat=use_stat, B=B_perm)
wt <- suppressWarnings(stats::wilcox.test(wide$HHH, wide$HRR, paired=TRUE, exact=FALSE))
tibble(
n_pairs = s$n_pairs,
obs_diff = s$obs,
p_perm_2s_label = s$p_lab,  null_mean_label = s$mu_lab,  null_sd_label = s$sd_lab,
p_perm_2s_repair= s$p_rep,  null_mean_repair= s$mu_rep,  null_sd_repair= s$sd_rep,
p_wilcoxon = unname(wt$p.value)
)
}
save_append <- function(df, path){
if (!file.exists(path)) {
write_csv(df, path)
} else {
suppressWarnings(write.table(df, file=path, sep=",", row.names=FALSE, col.names=FALSE, append=TRUE))
}
}
# --------- RUN BAND-BY-BAND (to keep memory low) ----------
stopifnot(file.exists(in_csv))
cat("Reading: ", in_csv, "\n")
# Pre-create output files with headers
f_perch <- file.path(out_dir, "wpli_per_channel_PERM_allbands_stream.csv")
f_global<- file.path(out_dir, "wpli_global_PERM_allbands_stream.csv")
if (file.exists(f_perch))  file.remove(f_perch)
if (file.exists(f_global)) file.remove(f_global)
write_csv(tibble(band=character(), ch=character(), stat_type=character(),
n_pairs=integer(), obs_diff=double(),
p_perm_2s_label=double(), null_mean_label=double(), null_sd_label=double(),
p_perm_2s_repair=double(), null_mean_repair=double(), null_sd_repair=double(),
p_wilcoxon=double()),
f_perch)
write_csv(tibble(band=character(), ch=character(), stat_type=character(),
n_pairs=integer(), obs_diff=double(),
p_perm_2s_label=double(), null_mean_label=double(), null_sd_label=double(),
p_perm_2s_repair=double(), null_mean_repair=double(), null_sd_repair=double(),
p_wilcoxon=double()),
f_global)
for (bb in bands_run){
cat("\n=== BAND:", bb, "===\n")
# read only needed columns, then filter band == bb to keep RAM down
dt <- fread(in_csv,
select = c("dyad_id","code","band","chA_name","chB_name","wpli"))
dt[, code := toupper(trimws(as.character(code)))]
dt[code %in% c("2","HHH"), code := "HHH"]
dt[code %in% c("3","HRR"), code := "HRR"]
if (!("band" %in% names(dt))) dt[, band := "broadband"]
dt <- dt[band == bb & code %in% c("HHH","HRR")]
# homologous only
dt <- dt[chA_name == chB_name]
dt[, ch := canon_ch(chA_name)]
# dyad × ch × cond means
dyad_means <- dt[, .(val = mean(wpli, na.rm=TRUE)), by=.(dyad_id, ch, code)] %>%
dplyr::filter(dyad_id != "E14")   # <- added
rm(dt); gc()
# ---- per-channel tests ----
chans <- sort(unique(dyad_means$ch))
for (cc in chans){
sub <- dyad_means[ ch == cc ]
ans <- test_one_group(sub)
out <- ans |>
mutate(band = bb, ch = cc, stat_type = use_stat, .before = 1)
save_append(out, f_perch)
}
rm(dyad_means); gc()
# ---- global (pooled channels) ----
# re-read compactly to avoid keeping per-channel means in RAM
dtg <- fread(in_csv, select = c("dyad_id","code","band","chA_name","chB_name","wpli"))
dtg[, code := toupper(trimws(as.character(code)))]
dtg[code %in% c("2","HHH"), code := "HHH"]
dtg[code %in% c("3","HRR"), code := "HRR"]
if (!("band" %in% names(dtg))) dtg[, band := "broadband"]
dtg <- dtg[band == bb & code %in% c("HHH","HRR") & chA_name == chB_name]
# dyad × cond pooled mean across channels
glob <- dtg[, .(val = mean(wpli, na.rm=TRUE)), by=.(dyad_id, code)] %>%
dplyr::filter(dyad_id != "E14")   # <- added
rm(dtg); gc()
ans_g <- test_one_group(glob)
out_g <- ans_g |>
mutate(band = bb, ch = "(pooled)", stat_type = use_stat, .before = 1)
save_append(out_g, f_global)
rm(glob); gc()
}
