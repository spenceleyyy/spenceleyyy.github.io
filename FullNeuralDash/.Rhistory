# --- 1. CLEANING FUNCTIONS ---
split_and_clean <- function(x) {
if(is.na(x) || x == "" || x == "NA") return("Not Specified")
items <- str_split(x, ",")[[1]]
items <- items %>%
str_replace_all("\\.", "") %>%  # Remove dots
str_squish() %>%                # Remove extra spaces
str_to_title()                  # Title Case
items <- items[items != "" & !is.na(items) & items != "Na"]
if(length(items) == 0) return("Not Specified")
return(items)
}
group_similar <- function(strings, threshold = 0.95) {
if(length(strings) <= 1) return(strings)
unique_strings <- unique(strings)
n <- length(unique_strings)
if(n == 1) return(strings)
mapping <- setNames(unique_strings, unique_strings)
for(i in 1:(n-1)) {
for(j in (i+1):n) {
sim <- 1 - stringdist(tolower(unique_strings[i]),
tolower(unique_strings[j]), method = "jw")
if(sim >= threshold) {
target <- if(nchar(unique_strings[i]) < nchar(unique_strings[j])) unique_strings[i] else unique_strings[j]
mapping[unique_strings[i]] <- target
mapping[unique_strings[j]] <- target
}
}
}
return(mapping[strings])
}
# --- 2. DATA PROCESSING ---
sankey_data <- read.csv("Sankey.csv", stringsAsFactors = FALSE)
# Select relevant columns
df <- sankey_data %>%
slice(-(1:2)) %>%
select(
measurement = X.15,      # This should contain EEG/fNIRS
automation = X.7,         # Type of automation
correlates = X.27         # Cognitive states
) %>%
filter(nzchar(measurement) & nzchar(automation))
# Process: Split, Clean, Unnest
df_processed <- df %>%
mutate(study_id = row_number()) %>%
mutate(across(c(measurement, automation, correlates), ~map(., split_and_clean))) %>%
unnest(measurement) %>% unnest(automation) %>% unnest(correlates)
# --- 3. CUSTOM RULES & RENAMING ---
df_processed <- df_processed %>%
mutate(
# Consolidate Workload
correlates = if_else(str_detect(correlates, regex("workload|worklaod", ignore_case = TRUE)),
"Workload",
correlates),
# Standardize measurement technique names
measurement = case_when(
str_detect(measurement, regex("eeg", ignore_case = TRUE)) ~ "EEG",
str_detect(measurement, regex("fnirs", ignore_case = TRUE)) ~ "fNIRS",
TRUE ~ measurement
)
) %>%
# Fuzzy match grouping
mutate(across(c(automation, correlates), ~as.character(group_similar(.)))) %>%
mutate(
# Disambiguate Not Specified
measurement = if_else(measurement == "Not Specified", "Not Specified (Technique)", measurement),
correlates  = if_else(correlates == "Not Specified", "Not Specified (State)", correlates)
)
# --- 4. LINKS & NODES ---
get_links <- function(data, src, tgt, group_name) {
data %>%
count(source = .data[[src]], target = .data[[tgt]]) %>%
rename(value = n) %>%
filter(value > 0) %>%
mutate(group = group_name)
}
# NEW FLOW: measurement (EEG/fNIRS) → automation → correlates
links_stage1 <- get_links(df_processed, "measurement", "automation", "Stage1")
links_stage2 <- get_links(df_processed, "automation", "correlates", "Stage2")
# For Stage1 links: origin is the source (measurement technique)
links_stage1 <- links_stage1 %>%
mutate(link_color = case_when(
source == "EEG" ~ "EEG",
source == "fNIRS" ~ "fNIRS",
TRUE ~ "Other"
))
# For Stage2 links: trace back through automation to find measurement origin
stage2_origins <- df_processed %>%
select(measurement, automation, correlates) %>%
distinct() %>%
group_by(automation, correlates) %>%
summarise(
origins = paste(unique(measurement), collapse = ","),
.groups = "drop"
)
links_stage2 <- links_stage2 %>%
left_join(stage2_origins, by = c("source" = "automation", "target" = "correlates")) %>%
mutate(
link_color = case_when(
str_detect(origins, "EEG") & str_detect(origins, "fNIRS") ~ "Both",
str_detect(origins, "EEG") ~ "EEG",
str_detect(origins, "fNIRS") ~ "fNIRS",
TRUE ~ "Other"
)
) %>%
select(source, target, value, group, link_color)
# Combine all links
links_final <- bind_rows(links_stage1, links_stage2)
nodes_list <- unique(c(links_final$source, links_final$target))
nodes <- data.frame(name = nodes_list, stringsAsFactors = FALSE)
# Assign Node Groups
get_stage <- function(name) {
if (str_detect(name, "Not Specified")) return("GreyNode")
if (name %in% c("EEG", "fNIRS")) {
return(if_else(name == "EEG", "EEG", "fNIRS"))
}
if (name %in% df_processed$measurement) return("Stage1")
if (name %in% df_processed$automation) return("Stage2")
return("Stage3")
}
nodes$group <- sapply(nodes$name, get_stage)
# Map indices
links_mapped <- links_final %>%
mutate(
source = match(source, nodes$name) - 1,
target = match(target, nodes$name) - 1
)
# Print to verify link_color column exists
print("Link colors:")
print(table(links_mapped$link_color))
# --- 5. VISUALIZATION ---
# Color scale for nodes - using green shades for both EEG and fNIRS
my_color <- 'd3.scaleOrdinal()
.domain(["EEG", "fNIRS", "Stage1", "Stage2", "Stage3", "GreyNode"])
.range(["#15803D", "#86EFAC", "#F4C8A4", "#B9E0A5", "#D696B9", "#A0A0A0"])'
# Color scale for links - consistent green shades
link_color <- 'd3.scaleOrdinal()
.domain(["EEG", "fNIRS", "Both", "Other"])
.range(["rgba(21, 128, 61, 0.6)", "rgba(134, 239, 172, 0.6)", "rgba(74, 222, 128, 0.6)", "rgba(160, 160, 160, 0.4)"])'
p <- sankeyNetwork(
Links = links_mapped,
Nodes = nodes,
Source = "source",
Target = "target",
Value = "value",
NodeID = "name",
NodeGroup = "group",
LinkGroup = "link_color",
units = "Studies",
fontSize = 12,
nodeWidth = 30,
colourScale = my_color,
sinksRight = FALSE,
margin = list(top = 50, bottom = 20, left = 20, right = 20)
)
# Add Headers and custom link colors
p_final <- htmlwidgets::onRender(p, '
function(el, x) {
var svg = d3.select(el).select("svg");
var width = svg.attr("width");
var section = width / 3;
var labels = ["Measurement Technique", "Type of Automation", "Cognitive States"];
// Add header labels
svg.selectAll(".header-label")
.data(labels)
.enter()
.append("text")
.attr("x", function(d, i) { return (section * i) + (section/2); })
.attr("y", 20)
.style("text-anchor", "middle")
.style("font-size", "14px")
.style("font-weight", "bold")
.style("font-family", "Arial")
.text(function(d) { return d; });
// Apply custom link colors based on link_color group
console.log("Applying link colors...");
svg.selectAll(".link")
.each(function(d) {
console.log("Link group:", d.group);
var linkColor;
if (d.group === "EEG") {
linkColor = "rgba(21, 128, 61, 0.6)";  // Dark green for ALL EEG links
} else if (d.group === "fNIRS") {
linkColor = "rgba(134, 239, 172, 0.6)";  // Light green for ALL fNIRS links
} else if (d.group === "Both") {
linkColor = "rgba(74, 222, 128, 0.6)";  // Medium green for mixed
} else {
linkColor = "rgba(160, 160, 160, 0.4)";  // Grey
}
d3.select(this)
.style("stroke", linkColor)
.style("stroke-opacity", null);  // Remove any default opacity
});
}
')
# --- 6. SAVE OUTPUTS ---
# 1. Save as HTML (Required first)
html_file <- "Sankey_Restructured.html"
saveWidget(p_final, html_file, selfcontained = TRUE)
# 2. Save as PDF
webshot(html_file, "Sankey_Restructured.pdf", vwidth = 1200, vheight = 900, delay = 1)
print(p_final)
